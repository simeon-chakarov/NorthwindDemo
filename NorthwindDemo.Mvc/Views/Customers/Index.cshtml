@model NorthwindDemo.Mvc.ViewModels.CustomerIndexViewModel

<h2>Customers</h2>

<form id="searchForm" method="get" class="d-flex gap-2 mb-3">
    <input id="searchInput"
           type="text"
           name="search"
           value="@Model.Search"
           class="form-control"
           style="max-width: 300px;"
           placeholder="Search by company name..." />

    <button type="submit" class="btn btn-primary">Search</button>
</form>

<table class="table table-striped table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>Company</th>
            <th>Orders</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var c in Model.Page.Items)
        {
            <tr>
                <td class="fw-semibold">@c.CompanyName</td>
                <td>@c.OrdersCount</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@c.Id">Details</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<nav class="d-flex justify-content-between align-items-center">
    <div class="text-muted">
        Page @Model.Page.Page of @Model.Page.TotalPages (@Model.Page.TotalCount total)
    </div>

    <ul class="pagination mb-0">
        <li class="page-item @(Model.Page.HasPrevious ? "" : "disabled")">
            <a class="page-link"
               asp-action="Index"
               asp-route-search="@Model.Search"
               asp-route-page="@(Model.Page.Page - 1)"
               asp-route-pageSize="@Model.Page.PageSize">
                Previous
            </a>
        </li>

        <li class="page-item @(Model.Page.HasNext ? "" : "disabled")">
            <a class="page-link"
               asp-action="Index"
               asp-route-search="@Model.Search"
               asp-route-page="@(Model.Page.Page + 1)"
               asp-route-pageSize="@Model.Page.PageSize">
                Next
            </a>
        </li>
    </ul>
</nav>

<script>
    fetch('https://localhost:7013/api/customers')
      .then(r => r.json())
      .then(_ => console.log('CORS OK'))
      .catch(e => console.error('CORS FAIL', e));

